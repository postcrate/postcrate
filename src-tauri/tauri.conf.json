{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "postcrate",
  "version": "0.1.0",
  "identifier": "dev.postcrate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "postcrate",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "preferences",
        "title": "Preferences",
        "url": "/preferences",
        "width": 820,
        "height": 620,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
